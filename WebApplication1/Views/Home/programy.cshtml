@{
    ViewData["Title"] = "Programy";
}

<main class="programy">

    <h1>Tréninkové programy</h1>

    <div class="program-row">
        <div class="program-big">
            <h2>Sílový trénink</h2>
            <p>Zaměřený na růst svalové hmoty a síly.</p>
        </div>
        <div class="program-small">
            <h3>3–4x týdně</h3>
        </div>
    </div>

    <div class="program-row">
        <div class="program-big">
            <h2>Spalování tuků</h2>
            <p>Kombinace kardia a funkčního tréninku.</p>
        </div>
        <div class="program-small">
            <h3>HIIT</h3>
        </div>
    </div>

    <div class="program-row">
        <div class="program-big">
            <h2>Funkční trénink</h2>
            <p>Zlepšení stability, koordinace a síly.</p>
        </div>
        <div class="program-small">
            <h3>Celé tělo</h3>
        </div>
    </div>

    <div class="program-row">
        <div class="program-big">
            <h2>Kondiční trénink</h2>
            <p>Zvýšení fyzické výdrže a energie.</p>
        </div>
        <div class="program-small">
            <h3>Kardio</h3>
        </div>
    </div>

    <div class="program-row">
        <div class="program-big">
            <h2>Regenerace &amp; Mobilita</h2>
            <p>Uvolnění svalů a prevence zranění.</p>
        </div>
        <div class="program-small">
            <h3>Stretch</h3>
        </div>
    </div>

</main>
