<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Fitness Urban</title>
    <link rel="stylesheet" href="~/css/style.css" />
    @RenderSection("Styles", required: false)
</head>
<body>

    <header>
        <h1>Fitness Urban</h1>
        <div class="navigace">
            <nav>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">Domů</a></li>
                    <li><a asp-controller="Home" asp-action="Kontakty">Kontakty</a></li>
                    <li><a asp-controller="Home" asp-action="Programy">Programy</a></li>
                    <li><a asp-controller="Home" asp-action="Cenik">Ceník</a></li>
                    @if (Context.Session.GetString("UserId") != null)
                    {
                        <li><a asp-controller="User" asp-action="Profile">👤 @Context.Session.GetString("UserName")</a></li>
                        <li><a asp-controller="User" asp-action="Logout">Odhlásit</a></li>
                    }
                    else
                    {
                        <li><a asp-controller="User" asp-action="Register">Registrace</a></li>
                        <li><a asp-controller="User" asp-action="Login">Přihlásit</a></li>
                    }
                </ul>
            </nav>
        </div>
    </header>

    @RenderBody()

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
