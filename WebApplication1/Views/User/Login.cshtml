@{
    ViewData["Title"] = "Přihlášení";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;800&display=swap');

    body {
        background: #0a0a0f;
        min-height: 100vh;
        margin: 0;
    }

    .auth-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        position: relative;
        overflow: hidden;
    }

    .auth-wrapper::before {
        content: '';
        position: fixed;
        top: -40%;
        left: -20%;
        width: 70vw;
        height: 70vw;
        background: radial-gradient(circle, rgba(0,210,255,0.07) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
    }

    .auth-wrapper::after {
        content: '';
        position: fixed;
        bottom: -30%;
        right: -10%;
        width: 50vw;
        height: 50vw;
        background: radial-gradient(circle, rgba(130,0,255,0.06) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
    }

    .auth-card {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 420px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 2.8rem 2.4rem;
        box-shadow: 0 0 60px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.06);
        backdrop-filter: blur(12px);
        animation: cardIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @@keyframes cardIn {
        from { opacity: 0; transform: translateY(24px) scale(0.97); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    .auth-logo {
        font-family: 'Space Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.3em;
        color: rgba(0,210,255,0.7);
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

    .auth-title {
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        font-size: 2rem;
        color: #f0f0f5;
        margin: 0 0 0.3rem;
        line-height: 1;
    }

    .auth-subtitle {
        font-family: 'Syne', sans-serif;
        color: rgba(255,255,255,0.35);
        font-size: 0.88rem;
        margin-bottom: 2rem;
    }

    .divider {
        height: 1px;
        background: linear-gradient(to right, transparent, rgba(0,210,255,0.3), transparent);
        margin-bottom: 2rem;
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

    .form-label {
        display: block;
        font-family: 'Space Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.15em;
        color: rgba(255,255,255,0.45);
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

    .form-input {
        width: 100%;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 10px;
        padding: 0.8rem 1rem;
        color: #e8e8f0;
        font-family: 'Syne', sans-serif;
        font-size: 0.95rem;
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        box-sizing: border-box;
        outline: none;
    }

    .form-input:focus {
        border-color: rgba(0,210,255,0.5);
        background: rgba(0,210,255,0.04);
        box-shadow: 0 0 0 3px rgba(0,210,255,0.1);
    }

    .form-input::placeholder {
        color: rgba(255,255,255,0.2);
    }

    .btn-primary {
        width: 100%;
        padding: 0.9rem;
        background: linear-gradient(135deg, #00d2ff, #7928ca);
        border: none;
        border-radius: 10px;
        color: white;
        font-family: 'Syne', sans-serif;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.05em;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
        margin-top: 0.6rem;
        position: relative;
        overflow: hidden;
    }

    .btn-primary::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0);
        transition: background 0.2s;
    }

    .btn-primary:hover {
        opacity: 0.92;
        transform: translateY(-1px);
        box-shadow: 0 8px 25px rgba(0,210,255,0.25);
    }

    .btn-primary:active {
        transform: translateY(0);
        opacity: 0.85;
    }

    .alert-error {
        background: rgba(255, 60, 80, 0.1);
        border: 1px solid rgba(255, 60, 80, 0.3);
        border-radius: 10px;
        padding: 0.75rem 1rem;
        color: #ff6b7a;
        font-family: 'Syne', sans-serif;
        font-size: 0.88rem;
        margin-bottom: 1.2rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .alert-success {
        background: rgba(0, 220, 130, 0.1);
        border: 1px solid rgba(0, 220, 130, 0.3);
        border-radius: 10px;
        padding: 0.75rem 1rem;
        color: #00dc82;
        font-family: 'Syne', sans-serif;
        font-size: 0.88rem;
        margin-bottom: 1.2rem;
    }

    .auth-footer {
        text-align: center;
        margin-top: 1.8rem;
        font-family: 'Syne', sans-serif;
        font-size: 0.85rem;
        color: rgba(255,255,255,0.3);
    }

    .auth-footer a {
        color: rgba(0,210,255,0.8);
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s;
    }

    .auth-footer a:hover {
        color: #00d2ff;
    }

    .grid-bg {
        position: fixed;
        inset: 0;
        background-image:
            linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
        z-index: 0;
    }
</style>
}

<div class="grid-bg"></div>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo">// přístup do systému</div>
        <h1 class="auth-title">Přihlášení</h1>
        <p class="auth-subtitle">Zadej své přihlašovací údaje</p>
        <div class="divider"></div>

        @if (ViewBag.Chyba != null)
        {
            <div class="alert-error">
                <span>⚠</span> @ViewBag.Chyba
            </div>
        }

        @if (ViewBag.Uspech != null)
        {
            <div class="alert-success">✓ @ViewBag.Uspech</div>
        }

        <form method="post" action="/User/Login">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-input" placeholder="tvuj@@email.cz" required />
            </div>
            <div class="form-group">
                <label class="form-label">Heslo</label>
                <input type="password" name="heslo" class="form-input" placeholder="••••••••" required />
            </div>
            <button type="submit" class="btn-primary">Přihlásit se →</button>
        </form>

        <div class="auth-footer">
            Nemáš účet? <a href="/User/Register">Zaregistruj se</a>
        </div>
    </div>
</div>
