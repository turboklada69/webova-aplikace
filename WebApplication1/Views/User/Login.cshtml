@{
    ViewData["Title"] = "Přihlášení";
}

<h2>Přihlášení</h2>

@if (ViewBag.Chyba != null)
{
    <p style="color:red;">@ViewBag.Chyba</p>
}

<form method="post">
    <div>
        <label>Email:</label>
        <input type="email" name="email" required />
    </div>
    <div>
        <label>Heslo:</label>
        <input type="password" name="heslo" required />
    </div>
    <button type="submit">Přihlásit</button>
</form>

<a href="/User/Register">Nemáš účet? Zaregistruj se</a>