@{
    ViewData["Title"] = "Můj profil";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body text-center p-5">
                <div class="mb-3">
                    <span style="font-size: 4rem;">👤</span>
                </div>
                <h3 class="card-title">Vítejte!</h3>
                <p class="text-muted">Přihlášen jako: <strong>@ViewBag.Email</strong></p>

                <hr />

                <div class="text-start mt-3">
                    <h5>Informace o účtu</h5>
                    <p><strong>E-mail:</strong> @ViewBag.Email</p>
                    <!-- TODO: zobrazit další údaje z databáze -->
                </div>

                <a href="/User/Logout" class="btn btn-outline-danger mt-3">Odhlásit se</a>
            </div>
        </div>
    </div>
</div>
