@{
    ViewData["Title"] = "Registrace";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;800&display=swap');

    body {
        background: #0a0a0f;
        min-height: 100vh;
        margin: 0;
    }

    .auth-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        position: relative;
        overflow: hidden;
    }

    .auth-wrapper::before {
        content: '';
        position: fixed;
        top: -40%;
        right: -20%;
        width: 70vw;
        height: 70vw;
        background: radial-gradient(circle, rgba(130,0,255,0.07) 0%, transparent 70%);
        pointer-events: none;
    }

    .auth-wrapper::after {
        content: '';
        position: fixed;
        bottom: -30%;
        left: -10%;
        width: 50vw;
        height: 50vw;
        background: radial-gradient(circle, rgba(0,210,255,0.06) 0%, transparent 70%);
        pointer-events: none;
    }

    .auth-card {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 420px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 2.8rem 2.4rem;
        box-shadow: 0 0 60px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.06);
        backdrop-filter: blur(12px);
        animation: cardIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @@keyframes cardIn {
        from { opacity: 0; transform: translateY(24px) scale(0.97); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    .auth-logo {
        font-family: 'Space Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.3em;
        color: rgba(130,0,255,0.7);
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

    .auth-title {
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        font-size: 2rem;
        color: #f0f0f5;
        margin: 0 0 0.3rem;
        line-height: 1;
    }

    .auth-subtitle {
        font-family: 'Syne', sans-serif;
        color: rgba(255,255,255,0.35);
        font-size: 0.88rem;
        margin-bottom: 2rem;
    }

    .divider {
        height: 1px;
        background: linear-gradient(to right, transparent, rgba(130,0,255,0.4), transparent);
        margin-bottom: 2rem;
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

    .form-label {
        display: block;
        font-family: 'Space Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.15em;
        color: rgba(255,255,255,0.45);
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

    .form-input {
        width: 100%;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 10px;
        padding: 0.8rem 1rem;
        color: #e8e8f0;
        font-family: 'Syne', sans-serif;
        font-size: 0.95rem;
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        box-sizing: border-box;
        outline: none;
    }

    .form-input:focus {
        border-color: rgba(130,0,255,0.5);
        background: rgba(130,0,255,0.04);
        box-shadow: 0 0 0 3px rgba(130,0,255,0.1);
    }

    .form-input::placeholder {
        color: rgba(255,255,255,0.2);
    }

    .btn-primary {
        width: 100%;
        padding: 0.9rem;
        background: linear-gradient(135deg, #7928ca, #00d2ff);
        border: none;
        border-radius: 10px;
        color: white;
        font-family: 'Syne', sans-serif;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.05em;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
        margin-top: 0.6rem;
    }

    .btn-primary:hover {
        opacity: 0.92;
        transform: translateY(-1px);
        box-shadow: 0 8px 25px rgba(121,40,202,0.3);
    }

    .btn-primary:active {
        transform: translateY(0);
        opacity: 0.85;
    }

    .alert-error {
        background: rgba(255, 60, 80, 0.1);
        border: 1px solid rgba(255, 60, 80, 0.3);
        border-radius: 10px;
        padding: 0.75rem 1rem;
        color: #ff6b7a;
        font-family: 'Syne', sans-serif;
        font-size: 0.88rem;
        margin-bottom: 1.2rem;
    }

    .password-hint {
        font-family: 'Space Mono', monospace;
        font-size: 0.65rem;
        color: rgba(255,255,255,0.25);
        margin-top: 0.35rem;
    }

    .auth-footer {
        text-align: center;
        margin-top: 1.8rem;
        font-family: 'Syne', sans-serif;
        font-size: 0.85rem;
        color: rgba(255,255,255,0.3);
    }

    .auth-footer a {
        color: rgba(0,210,255,0.8);
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s;
    }

    .auth-footer a:hover {
        color: #00d2ff;
    }

    .grid-bg {
        position: fixed;
        inset: 0;
        background-image:
            linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
        z-index: 0;
    }

    .tag {
        display: inline-block;
        font-family: 'Space Mono', monospace;
        font-size: 0.6rem;
        background: rgba(130,0,255,0.15);
        border: 1px solid rgba(130,0,255,0.3);
        color: rgba(180,100,255,0.9);
        border-radius: 4px;
        padding: 0.15rem 0.45rem;
        letter-spacing: 0.1em;
        margin-left: 0.5rem;
        vertical-align: middle;
    }
</style>
}

<div class="grid-bg"></div>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo">// nový účet</div>
        <h1 class="auth-title">Registrace <span class="tag">FREE</span></h1>
        <p class="auth-subtitle">Vytvoř si účet zdarma</p>
        <div class="divider"></div>

        @if (ViewBag.Chyba != null)
        {
            <div class="alert-error">⚠ @ViewBag.Chyba</div>
        }

        <form method="post" action="/User/Register">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">Jméno</label>
                <input type="text" name="Jmeno" class="form-input" placeholder="Jan Novák" required />
            </div>
            <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email" name="Email" class="form-input" placeholder="tvuj@@email.cz" required />
            </div>
            <div class="form-group">
                <label class="form-label">Heslo</label>
                <input type="password" name="Heslo" class="form-input" placeholder="••••••••" required minlength="6" />
                <p class="password-hint">// min. 6 znaků</p>
            </div>
            <button type="submit" class="btn-primary">Vytvořit účet →</button>
        </form>

        <div class="auth-footer">
            Už máš účet? <a href="/User/Login">Přihlas se</a>
        </div>
    </div>
</div>
