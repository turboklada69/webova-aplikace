@{
    ViewData["Title"] = "Registrace";
}

<h2>Registrace</h2>

<form method="post">
    <div>
        <label>Jméno:</label>
        <input type="text" name="Jmeno" required />
    </div>
    <div>
        <label>Email:</label>
        <input type="email" name="Email" required />
    </div>
    <div>
        <label>Heslo:</label>
        <input type="password" name="Heslo" required />
    </div>
    <button type="submit">Registrovat</button>
</form>

<a href="/User/Login">Už máš účet? Přihlas se</a>